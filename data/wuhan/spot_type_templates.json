{
  "meta": {
    "version": "0.1",
    "updated": "2026-10-19",
    "description": "景点类型的气象敏感性模板。每个景点通过 type 字段继承一个模板，再用 sensitivity_overrides 做单点修正。",
    "weight_scale": "0=不影响 1=低 2=中 3=高",
    "threshold_semantics": "good=适宜上限/区间；bad=不宜阈值；介于两者之间为'可接受'。数值单位见 factors。",
    "status": "v0：阈值来自国家/行业标准或经验值，经验值均标注'待校准'，后续用历史数据回测修正",
    "review": "2026-10-19 经独立复核：修正 AQI 口径、降水概率依据、雾/霾标准拆分、风速单位，补低温阈值与阵风因子"
  },
  "factors": {
    "precip": {
      "name": "逐时降水量",
      "unit": "mm/h",
      "source_var": "precipitation"
    },
    "precip_prob": {
      "name": "逐时降水概率",
      "unit": "%",
      "source_var": "precipitation_probability"
    },
    "apparent_temp": {
      "name": "体感温度",
      "unit": "℃",
      "source_var": "apparent_temperature"
    },
    "wind10_speed": {
      "name": "10米风速",
      "unit": "m/s",
      "source_var": "wind_speed_10m（Open-Meteo 默认 km/h，请求时须带 wind_speed_unit=ms）"
    },
    "visibility": {
      "name": "能见度",
      "unit": "km",
      "source_var": "visibility（Open-Meteo 单位为米，数据层换算成 km；为模式诊断量，非观测值）"
    },
    "uv_index": {
      "name": "紫外线指数",
      "unit": "",
      "source_var": "uv_index"
    },
    "thunder": {
      "name": "雷暴",
      "unit": "bool",
      "source_var": "weather_code ∈ {95,96,99}（Open-Meteo 采用 WMO 4677 码，预报中为模式诊断量，命中率需回测）"
    },
    "aqi": {
      "name": "空气质量指数",
      "unit": "",
      "source_var": "国标 AQI：用 Open-Meteo 的 pm2_5、pm10、o3 等浓度按 HJ 633-2012 断点自算；不可直接用 us_aqi（断点不同）"
    },
    "wind_gusts": {
      "name": "10米阵风",
      "unit": "m/s",
      "source_var": "wind_gusts_10m（同上，须带 wind_speed_unit=ms）"
    }
  },
  "basis": {
    "wind": "GB/T 28591-2012《风力等级》：5级 8.0–10.7 m/s，6级 10.8–13.8 m/s",
    "precip_daily": "GB/T 28592-2012《降水量等级》（日/12h 分级）；逐时阈值无对应国标，为经验值待校准",
    "heat": "中国气象局高温以日最高气温≥35℃为界；体感温度阈值为经验值待校准。GB/T 27963-2011《人居环境气候舒适度评价》使用温湿指数、风效指数等指标，与 apparent_temperature 不是同一量，仅作参考",
    "visibility": "雾 <1 km、轻雾 1–10 km：《地面气象观测规范》、GB/T 27964-2011《雾的预报等级》（待核对原文）；霾：GB/T 36542-2018《霾的观测识别》（能见度 <10 km 并排除降水等，湿度条件待核对原文）；远眺 <5 km 为经验值待校准",
    "uv": "WHO 紫外线指数分级：6–7 高，8–10 很高，≥11 极高；国标 GB/T 36744-2018《紫外线指数预报方法》附录 B 有等级划分（待核对原文）",
    "aqi": "HJ 633-2012：AQI 101–150 轻度污染，151–200 中度污染",
    "thunder": "Open-Meteo 采用 WMO 4677 码，95/96/99 为雷暴；雷暴时户外开阔/高处有雷击风险",
    "empirical": "经验值，无对应国家/行业标准，待用历史数据回测校准",
    "cold": "低温不宜阈值为经验值待校准（武汉冬季体感温度常低于 0℃）"
  },
