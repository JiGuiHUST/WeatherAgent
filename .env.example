# 本机 .env 已配置；请不要公开该文件。
# 在新机器上复制本文件为 .env 并填入自己的密钥。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 可选运行配置
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# 未设置时会生成并持久保存本机会话密钥
# FLASK_SECRET_KEY=
# Open-Meteo 公开天气接口无需 WEATHER_TOKEN

# 华风爱科：取得标准 OpenAPI Key 并通过真实探测后再激活。
WEATHER_PROVIDER=auto
WEATHERCN_OPENAPI_KEY=
WEATHERCN_ENABLED=0
WEATHERCN_FORECAST_HOURS=72
WEATHERCN_DAILY_LIMIT=450
# 文档推荐 header；2026-10-28 当前试用网关实测需 query，密钥仅在后端发送。
WEATHERCN_AUTH_MODE=query
